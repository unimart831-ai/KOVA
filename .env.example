# ─── DJANGO CORE ──────────────────────────────────────────────────────────────
SECRET_KEY=your-secret-key-here-change-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:8000

# ─── DATABASE ────────────────────────────────────────────────────────────────
# Railway auto-sets DATABASE_URL when you add Postgres plugin
DATABASE_URL=postgres://kova:kova@localhost:5432/kova_agent

# ─── REDIS ───────────────────────────────────────────────────────────────────
# Railway auto-sets REDIS_URL when you add Redis plugin
REDIS_URL=redis://localhost:6379/0

# ─── ENCRYPTION ──────────────────────────────────────────────────────────────
# REQUIRED in production. Must be separate from SECRET_KEY.
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FIELD_ENCRYPTION_KEY=

# ─── EMAIL ───────────────────────────────────────────────────────────────────
# Dev: console backend. Prod: Resend (REQUIRED).
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=Kova Agent <noreply@kovaagent.com>
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=

# ─── SITE ────────────────────────────────────────────────────────────────────
SITE_URL=http://localhost:8000

# ─── AI / LLM (provider: openai | anthropic | openrouter) ───────────────────
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
DEFAULT_LLM_PROVIDER=openrouter
DEFAULT_LLM_MODEL=deepseek/deepseek-v3.2

# Tiered model routing (override individual tiers or leave defaults)
# LLM_MODEL_PREMIUM=deepseek/deepseek-v3.2
# LLM_MODEL_WORKHORSE=deepseek/deepseek-v3.2
# LLM_MODEL_FAST=deepseek/deepseek-v3.2
# LLM_PAID_FALLBACK=google/gemini-2.0-flash-001
# LLM_PAID_FALLBACK_PROVIDER=openrouter

# ─── AI IMAGE GENERATION ────────────────────────────────────────────────────
AI_IMAGE_GENERATION_ENABLED=True
# Option 1: Together AI — $0.003/image, sign up at https://api.together.xyz
TOGETHER_API_KEY=
TOGETHER_IMAGE_MODEL=black-forest-labs/FLUX.1-schnell
# Option 2: HuggingFace — free (rate-limited), https://huggingface.co/settings/tokens
HF_TOKEN=
# Option 3: Pollinations — free tier, https://pollinations.ai
POLLINATIONS_API_KEY=
AI_IMAGE_MODEL=flux

