# Django
SECRET_KEY=your-secret-key-here-change-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database (Railway auto-sets DATABASE_URL when you add Postgres plugin)
DATABASE_URL=postgres://kova:kova@localhost:5432/kova_agent

# Redis (Railway auto-sets REDIS_URL when you add Redis plugin)
REDIS_URL=redis://localhost:6379/0

# Email (development uses console backend)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend

# AI / LLM  (provider: openai | anthropic | openrouter)
OPENAI_API_KEY=sk-your-openai-key
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key
OPENROUTER_API_KEY=sk-or-your-openrouter-key
DEFAULT_LLM_PROVIDER=openrouter
DEFAULT_LLM_MODEL=google/gemini-2.0-flash-001

# AI Image Generation — Flux Schnell (pick at least one)
# Option 1: Together AI — $0.003/image, sign up at https://api.together.xyz
TOGETHER_API_KEY=
TOGETHER_IMAGE_MODEL=black-forest-labs/FLUX.1-schnell
# Option 2: HuggingFace — free (rate-limited), token at https://huggingface.co/settings/tokens
HF_TOKEN=
# Option 3: Pollinations — free tier, key at https://pollinations.ai
POLLINATIONS_API_KEY=

# Stripe
STRIPE_PUBLISHABLE_KEY=pk_test_your-stripe-public-key
STRIPE_SECRET_KEY=sk_test_your-stripe-secret-key
STRIPE_WEBHOOK_SECRET=whsec_your-stripe-webhook-secret

# Social Platform OAuth
TWITTER_CLIENT_ID=
TWITTER_CLIENT_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# Sentry (production only)
SENTRY_DSN=

