# ─── DJANGO CORE ──────────────────────────────────────────────────────────────
SECRET_KEY=your-secret-key-here-change-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:8000
# Production (Railway sets automatically):
# DJANGO_SETTINGS_MODULE=config.settings.production

# ─── DATABASE ────────────────────────────────────────────────────────────────
# Railway auto-sets DATABASE_URL when you add Postgres plugin
DATABASE_URL=postgres://kova:kova@localhost:5432/kova_agent

# ─── REDIS ───────────────────────────────────────────────────────────────────
# Railway auto-sets REDIS_URL when you add Redis plugin (same URL for Celery + Channels).
REDIS_URL=redis://localhost:6379/0
# Optional: raise if WebSocket /ws/updates/ times out on Railway internal network
# CHANNEL_REDIS_CONNECT_TIMEOUT=15
# CHANNEL_REDIS_SOCKET_TIMEOUT=15

# ─── ENCRYPTION ──────────────────────────────────────────────────────────────
# REQUIRED in production. Must be separate from SECRET_KEY.
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FIELD_ENCRYPTION_KEY=

# ─── EMAIL ───────────────────────────────────────────────────────────────────
# Dev: console backend. Prod: Resend (REQUIRED).
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=Kova Agent <noreply@kovaagent.com>
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=

# ─── SITE ────────────────────────────────────────────────────────────────────
SITE_URL=http://localhost:8000

# ─── SHOPIFY (Pro+ revenue integration) ─────────────────────────────────────
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_SCOPES=read_products,write_products,read_orders,read_inventory

# ─── AI / LLM (provider: openai | anthropic | openrouter) ───────────────────
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
DEFAULT_LLM_PROVIDER=openrouter
DEFAULT_LLM_MODEL=deepseek/deepseek-v3.2

# Tiered model routing (override individual tiers or leave defaults)
# LLM_MODEL_PREMIUM=deepseek/deepseek-v3.2
# LLM_MODEL_WORKHORSE=deepseek/deepseek-v3.2
# LLM_MODEL_FAST=deepseek/deepseek-v3.2
# LLM_PAID_FALLBACK=google/gemini-2.0-flash-001
# LLM_PAID_FALLBACK_PROVIDER=openrouter

# ─── AI IMAGE GENERATION ────────────────────────────────────────────────────
AI_IMAGE_GENERATION_ENABLED=True
# Option 1: Together AI — $0.003/image, sign up at https://api.together.xyz
TOGETHER_API_KEY=
TOGETHER_IMAGE_MODEL=black-forest-labs/FLUX.1-schnell
# Option 2: HuggingFace — free (rate-limited), https://huggingface.co/settings/tokens
HF_TOKEN=
# Option 3: Pollinations — free tier, https://pollinations.ai
POLLINATIONS_API_KEY=
AI_IMAGE_MODEL=flux

# ─── STUDIO POLISH (Photoroom Plus) ────────────────────────────────────────────
# v2/edit — cutout, shadow, studio background — see docs/VISUAL_ENHANCEMENT_SPEC.md
PHOTOROOM_API_KEY=
VISUAL_ENHANCE_ENABLED=True
PHOTOROOM_MONTHLY_POOL=5000
PHOTOROOM_POOL_RESERVE=500
PHOTOROOM_MONTHLY_COST_USD=500
PHOTOROOM_OUTPUT_SIZE=1080x1080
PHOTOROOM_PADDING=0.06
PHOTOROOM_DEFAULT_SHADOW=ai.preset-soft
# Set True to prepend sandbox_ to your API key (free watermarked test calls)
PHOTOROOM_SANDBOX=True
# PhotoFix runs on every Snap/Batch upload; Composition hero for batch showcase reels
PHOTOROOM_PHOTOFIX_ENABLED=True
PHOTOROOM_COMPOSITION_ENABLED=True
# Phase 1 — Google Shopping marketplace exports (PNG + JPEG, 1000×1000 white bg)
PHOTOROOM_MARKETPLACE_EXPORT_ENABLED=True
PHOTOROOM_MARKETPLACE_SIZE=1000x1000
PHOTOROOM_MARKETPLACE_PADDING=0.075
# Batch Snap Market Day preset (brand hero, PhotoFix, composition hero)
PHOTOROOM_MARKET_DAY_ENABLED=True
# Color-safe relight for product listings (services keep ai.auto)
PHOTOROOM_RELIGHT_PRODUCT_MODE=ai.preserve-hue-and-saturation
# Reels try /v1/animate when SANDBOX=True or VIDEO_ENABLED=True (FFmpeg fallback)
PHOTOROOM_REEL_USE_VIDEO_API=True
PHOTOROOM_VIDEO_ENABLED=False
PHOTOROOM_UNCERTAINTY_HIGH_THRESHOLD=0.6
PHOTOROOM_UNCERTAINTY_PROBE_ENABLED=True
PHOTOROOM_SANDBOX_DAILY_LIMIT=100
PHOTOROOM_SANDBOX_MONTHLY_LIMIT=1000
PHOTOROOM_SMART_CROP_PADDING=10%
PHOTOROOM_SCALING=fill
PHOTOROOM_EDIT_WITH_AI_ENABLED=True
PHOTOROOM_EDIT_WITH_AI_MAX_PER_PACK=2
REEL_MAX_SLIDES=5
REEL_DIRECTOR_ENABLED=True
PHOTOROOM_DEFAULT_BLUR_MODE=bokeh
# Phase 2 — Basic cutout routing, food presets, apparel review gate, shadow model A/B
PHOTOROOM_BASIC_API_KEY=
PHOTOROOM_BASIC_ROUTING_ENABLED=True
PHOTOROOM_REVIEW_ALTERATIONS=True
PHOTOROOM_AI_SHADOWS_MODEL_ENABLED=True
# Legacy (unused)
FAL_KEY=

# ─── WEB SEARCH (Tavily — Research Agent) ────────────────────────────────────
# Free tier: 1000 searches/month — https://tavily.com
TAVILY_API_KEY=

# ─── STRIPE ──────────────────────────────────────────────────────────────────
STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_GROWTH=
STRIPE_PRICE_PRO=
STRIPE_PRICE_AGENCY=

# ─── M-PESA (Daraja API) ────────────────────────────────────────────────────
MPESA_ENVIRONMENT=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=174379
MPESA_PASSKEY=
MPESA_CALLBACK_URL=
MPESA_COMMERCE_CALLBACK_URL=
# Required in production — append ?token=<secret> to MPESA_CALLBACK_URL
MPESA_WEBHOOK_SECRET=
MPESA_TRIAL_DAYS=14

# ─── SOCIAL PLATFORM OAUTH ──────────────────────────────────────────────────
# Google sign-in (signup/login) — optional; button hidden until both are set
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
TWITTER_CLIENT_ID=
TWITTER_CLIENT_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FB_LOGIN_CONFIG_ID=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
PINTEREST_APP_ID=
PINTEREST_APP_SECRET=
THREADS_APP_ID=
THREADS_APP_SECRET=

# ─── WHATSAPP CLOUD API ─────────────────────────────────────────────────────
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_WABA_ID=
WHATSAPP_VERIFY_TOKEN=          # Meta webhook verify token (WhatsApp + Messenger Page webhooks)
WHATSAPP_APP_SECRET=
FB_WA_CONFIG_ID=

# ─── CLOUDFLARE R2 (S3-compatible media storage) ────────────────────────────
AWS_STORAGE_BUCKET_NAME=
AWS_S3_ENDPOINT_URL=
AWS_S3_ACCESS_KEY_ID=
AWS_S3_SECRET_ACCESS_KEY=
AWS_S3_CUSTOM_DOMAIN=

# ─── MONITORING ──────────────────────────────────────────────────────────────
# REQUIRED in production
SENTRY_DSN=

# ─── FEATURE FLAGS ───────────────────────────────────────────────────────────
ENGAGE_GRADUATED_AUTONOMY_ENABLED=False
# Default True in config/settings/base.py — enables Adapt v2 learning loop for Pro+ (see PLAN_LIMITS)
ADAPT_AGENT_V2_ENABLED=True

# ─── COMMERCE SANDBOX (dev / test businesses — see docs/TEST_BUSINESSES.md) ─
# M-Pesa: MPESA_ENVIRONMENT=sandbox + Safaricom test phone 254708374149
# Shopify: create a dev store, set SHOPIFY_API_KEY/SECRET, connect from Analytics → Revenue
# Kova Pixel: generated per user at Analytics → Pixel (no extra env vars in dev)

# ─── ONBOARDING ──────────────────────────────────────────────────────────────
KOVA_ONBOARDING_TEMPLATE_NAME=
KOVA_ONBOARDING_TEMPLATE_LANG=en

# ─── CELERY (worker + beat — separate Railway services) ─────────────────────
# Uses REDIS_URL as broker. Beat requires django-celery-beat tables (migrate on deploy).
# CELERY_BROKER_URL=  # defaults to REDIS_URL
# CELERY_RESULT_BACKEND=  # defaults to REDIS_URL

# ─── CHANNELS / WEBSOCKETS (Daphne on Railway web service) ────────────────────
# ASGI_APPLICATION=config.asgi.application

# ─── RAILWAY-SPECIFIC (auto-provided) ───────────────────────────────────────
# RAILWAY_PUBLIC_DOMAIN=your-app.up.railway.app
# CUSTOM_DOMAIN=app.yourdomain.com
# Release phase: scripts/release.sh runs `migrate --noinput` before traffic switch
